[Unit]
Description=Hal memory: sort, link and index the vault while the computer is idle
PartOf=hal.target
After=graphical-session.target
X-HalGPU=yes

[Service]
WorkingDirectory=@ROOT@
ExecStart=@PYTHON@ -m halmem.idle
Environment=PYTHONUNBUFFERED=1
Nice=10
Restart=on-failure
RestartSec=30

[Install]
WantedBy=hal.target
