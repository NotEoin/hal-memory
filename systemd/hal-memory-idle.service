[Unit]
Description=Hal memory: sort, link and index the vault while the computer is idle
After=graphical-session.target

[Service]
WorkingDirectory=%h/src/hal-ecosystem/hal-memory
ExecStart=/usr/bin/python3 -m halmem.idle
Environment=PYTHONUNBUFFERED=1
Nice=10
Restart=on-failure
RestartSec=30

[Install]
WantedBy=graphical-session.target
